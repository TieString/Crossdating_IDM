{
  "automatic_writeback": false,
  "bundle_version": "current-event-range-v1.0.0",
  "candidate_pool": "selected_top500",
  "feature_variant": "deployable_no_missing_count",
  "insertion_order": "newest_to_oldest",
  "pipeline_config": {
    "candidate": {
      "algorithmic_peak_half_window": 5,
      "algorithmic_peak_half_window_mixed_lag": 10,
      "algorithmic_peak_half_window_no_cofecha_event": 10,
      "algorithmic_top_k": 10,
      "counterfactual_top_k": 15,
      "counterfactual_window_half": 10,
      "expand_algorithmic_peaks": true,
      "fallback_to_algorithmic": true,
      "include_algorithmic_candidates": true,
      "max_algorithmic_expanded_candidates": 200,
      "max_hybrid_candidates": 280,
      "oracle_window": 15,
      "rolling_transition_conditional_fallback": true,
      "rolling_transition_fallback_peak_half_window": 10,
      "rolling_transition_fallback_top1_score_lt": 1.04,
      "rolling_transition_half_window": 20,
      "rolling_transition_lags": [
        -3,
        -2,
        -1,
        0,
        1,
        2,
        3
      ],
      "rolling_transition_min_overlap": 12,
      "rolling_transition_rank_radii": [
        12,
        15,
        18
      ],
      "rolling_transition_suppress_radius": 10,
      "source": "oracle",
      "use_counterfactual_topk": true
    },
    "cofecha": {
      "cache_dir": "artifacts/cofecha_cache",
      "enabled": false,
      "exe_path": "itrdb/cofecha.exe",
      "keep_workspace_on_error": true,
      "lag_profile_max_window": 25,
      "lag_profile_newest_max_window": 80,
      "lag_profile_newest_only_extra_padding": 20,
      "lag_profile_newest_padding_years": 15,
      "lag_profile_padding_years": 5,
      "max_parallel": 1,
      "mode": "dynamic",
      "parse_sections": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ],
      "reuse_cache": true,
      "stdin_blank_lines": 4,
      "task_prefix": "MR",
      "timeout_seconds": 60,
      "use_part_a_lag_profile": true,
      "use_part_b_effects": false,
      "use_part_c_yoy": false,
      "use_part_d_absent": false,
      "use_part_e_outliers": false,
      "workspace_dir": "artifacts/cofecha_runs"
    },
    "data": {
      "cofecha_dir": "itrdb/cofecha",
      "cofecha_exe": "itrdb/cofecha.exe",
      "measurements_dir": "itrdb/measurements",
      "metadata_dir": "itrdb/metadata"
    },
    "filter": {
      "max_zero_density": 0.08,
      "min_distance_from_start_end": 10,
      "min_nonzero_count": 70,
      "min_overlap_with_master": 80,
      "min_reference_series_per_site": 5,
      "min_series_length": 80,
      "zero_isolation_radius": 2
    },
    "model": {
      "ambiguous_margin": 0.08,
      "fallback": "logistic_regression",
      "preferred": "lightgbm"
    },
    "output": {
      "cofecha_cache_dir": "artifacts/cofecha_cache",
      "cofecha_workspace_dir": "artifacts/cofecha_runs",
      "dataset_dir": "artifacts/datasets/missing_ring_dataset",
      "model_dir": "models",
      "report_dir": "artifacts/reports"
    },
    "parser": {
      "preserve_zero": true,
      "rwl_extensions": [
        ".rwl"
      ],
      "stop_markers": [
        -9999,
        999
      ]
    },
    "site_id": {
      "keep_region_path": true,
      "normalize_case": "lower",
      "source": "file_stem",
      "strip_extensions": true
    },
    "split": {
      "method": "site",
      "seed": 42,
      "train_ratio": 0.7
    }
  },
  "protocol_version": "crossdating.current-event.v1",
  "range_radius": 1,
  "score_semantics": {
    "ranking_score": "relative ranking score, not probability",
    "reliability_probability": "round-level selector output; not a candidate-year probability"
  },
  "selected_top_k": 500,
  "top_k": 5,
  "zero_policy": "drop_existing_zero_markers_then_apply_confirmed_insertions"
}
