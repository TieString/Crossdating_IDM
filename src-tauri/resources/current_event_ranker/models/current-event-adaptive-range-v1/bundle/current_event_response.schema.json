{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crossdating.current-event.v1.response",
  "title": "Current-event sidecar response",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "requestId", "ok"],
  "properties": {
    "protocolVersion": {"const": "crossdating.current-event.v1"},
    "requestId": {"type": ["string", "null"]},
    "ok": {"type": "boolean"},
    "result": {
      "type": "object",
      "properties": {
        "status": {"type": "string"},
        "reasonCode": {"type": ["string", "null"]},
        "message": {"type": "string"},
        "eventRange": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["startYear", "endYear", "centerYear", "width", "scope", "localizerScore", "baseCenterRank", "candidateCenterCount", "scoreSemantics"],
          "properties": {
            "startYear": {"type": "integer"},
            "endYear": {"type": "integer"},
            "centerYear": {"type": "integer"},
            "width": {"type": "integer", "minimum": 1, "maximum": 15},
            "scope": {"const": "newest_unresolved_event"},
            "localizerScore": {"type": "number"},
            "learnedScore": {"type": "number"},
            "intervalSoftmaxMass": {"type": "number"},
            "baseCenterRank": {"type": "integer", "minimum": 1, "maximum": 120},
            "candidateCenterCount": {"type": "integer", "minimum": 1, "maximum": 120},
            "scoreSemantics": {"type": "string"},
            "adaptive": {"type": "boolean"},
            "shrunk": {"type": "boolean"},
            "windowPolicy": {"const": "local_score_mass"},
            "maxEnvelopeStart": {"type": "integer"},
            "maxEnvelopeEnd": {"type": "integer"},
            "evidencePeak": {"type": "number"},
            "evidenceMass": {"type": "number"}
          }
        },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rank", "centerYear", "rangeStart", "rangeEnd", "rankingScore"],
            "properties": {
              "rank": {"type": "integer", "minimum": 1},
              "centerYear": {"type": "integer"},
              "rangeStart": {"type": "integer"},
              "rangeEnd": {"type": "integer"},
              "rankingScore": {"type": "number"},
              "baseRank": {"type": "integer", "minimum": 1},
              "rangePromoted": {"type": "boolean"},
              "legacyBinaryRank": {"type": "integer"},
              "compressionRank": {"type": "integer"},
              "evidence": {"type": "object"}
            }
          }
        },
        "rangeReliability": {
          "type": "object",
          "required": ["accepted", "score", "threshold", "semantics"],
          "properties": {
            "accepted": {"type": "boolean"},
            "score": {"type": "number"},
            "threshold": {"type": "number"},
            "independentFromYearGate": {"type": "boolean"},
            "semantics": {"type": "string"}
          }
        },
        "yearReliability": {
          "type": "object",
          "required": ["accepted", "score", "threshold", "semantics"],
          "properties": {
            "accepted": {"type": "boolean"},
            "score": {"type": "number"},
            "threshold": {"type": "number"},
            "semantics": {"type": "string"}
          }
        },
        "reliability": {"type": "object", "description": "向后兼容别名，等同 yearReliability"},
        "state": {"type": "object"},
        "diagnostics": {"type": "object"},
        "diagnosticOnly": {"type": "boolean"},
        "automaticWriteback": {"type": "boolean"},
        "scoreSemantics": {"type": "string"},
        "elapsedMs": {"type": "number"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "retryable": {"type": "boolean"},
        "details": {"type": "object"}
      }
    }
  },
  "oneOf": [
    {"properties": {"ok": {"const": true}}, "required": ["result"]},
    {"properties": {"ok": {"const": false}}, "required": ["error"]}
  ]
}
