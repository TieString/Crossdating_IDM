{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crossdating.current-event.rrf.v1.request",
  "title": "Frozen RRF current missing-event request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "requestId", "method"],
  "properties": {
    "protocolVersion": {"const": "crossdating.current-event.v1"},
    "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
    "method": {"enum": ["health", "describe", "rank_current_event", "shutdown"]},
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rwlPath", "targetSeriesId"],
      "properties": {
        "rwlPath": {"type": "string", "minLength": 1},
        "targetSeriesId": {"type": "string", "minLength": 1, "maxLength": 64},
        "existingZeroPolicy": {"const": "remove", "default": "remove"},
        "confirmedInsertions": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["year"],
            "properties": {
              "year": {"type": "integer", "minimum": -12000, "maximum": 3000}
            }
          }
        },
        "topK": {"const": 5, "default": 5},
        "rangeRadius": {"const": 3, "default": 3}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"method": {"const": "rank_current_event"}}},
      "then": {"required": ["params"]}
    }
  ]
}
