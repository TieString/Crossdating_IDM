{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crossdating.current-event.rrf.v1.response",
  "title": "Frozen RRF current missing-event response",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "requestId", "ok"],
  "properties": {
    "protocolVersion": {"const": "crossdating.current-event.v1"},
    "requestId": {"type": ["string", "null"]},
    "ok": {"type": "boolean"},
    "result": {
      "type": "object",
      "properties": {
        "status": {"type": "string"},
        "reasonCode": {"type": ["string", "null"]},
        "message": {"type": "string"},
        "routeVersion": {"const": "missing-current-event-rrf0-range3-v1"},
        "operationScope": {
          "oneOf": [
            {"const": "insert_missing"},
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {"const": "insert_missing"}
            }
          ]
        },
        "diagnosticOnly": {"type": "boolean"},
        "suggestions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["rank", "centerYear", "rangeStart", "rangeEnd", "rankingScore"],
            "properties": {
              "rank": {"type": "integer", "minimum": 1},
              "centerYear": {"type": "integer"},
              "rangeStart": {"type": "integer"},
              "rangeEnd": {"type": "integer"},
              "rankingScore": {"type": "number"},
              "scoreSemantics": {"type": "string"},
              "evidence": {"type": "object"}
            }
          }
        },
        "reliability": {"type": "object"},
        "state": {"type": "object"},
        "diagnostics": {"type": "object"},
        "elapsedMs": {"type": "number"},
        "automaticWriteback": {"type": "boolean"},
        "scoreSemantics": {"type": ["string", "object"]}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "retryable": {"type": "boolean"},
        "details": {"type": "object"}
      }
    }
  },
  "oneOf": [
    {"properties": {"ok": {"const": true}}, "required": ["result"]},
    {"properties": {"ok": {"const": false}}, "required": ["error"]}
  ]
}
