{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crossdating-IDM",
  "version": "1.1.4",
  "identifier": "com.crossdating.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "交叉定年-IDM",
        "width": 800,
        "height": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/IDM.png"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "externalBin":[
      "bin/cofecha"
    ]
  }
}