{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Crossdating-IDM",
  "version": "1.5.0",
  "identifier": "com.crossdating.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "交叉定年-IDM",
        "width": 800,
        "height": 600,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/IDM.png"
    ],
    "resources": {
      "../test-data/": "test-data/",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
