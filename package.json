    "validate": "npm run validate:samples && npm run validate:workspace-windows && npm run validate:auto-crossdating && npm run validate:cofecha-reference",
    "validate:samples": "node scripts/validate-samples.mjs",
    "validate:cofecha:samples": "node scripts/validate-cofecha-samples.mjs",
    "validate:workspace-windows": "node scripts/validate-workspace-windows.mjs",
    "validate:auto-crossdating": "node scripts/validate-auto-crossdating.mjs",
    "validate:cofecha-reference": "node scripts/validate-cofecha-reference.mjs",
    "benchmark:co612-zero-frontier-matrix": "node scripts/run-co612-zero-frontier-matrix.mjs",
    "export:tree-ring-scan-fixtures": "vite-node scripts/export-tree-ring-scan-fixtures.ts",
    "validate:tree-ring-scan-pair": "vite-node scripts/validate-tree-ring-scan-pair.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-fs": "~2",
