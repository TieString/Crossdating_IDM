{
  "name": "Crossdating-IDM",
  "private": true,
  "version": "1.5.0",
  "description": "面向树轮 RWL 数据的可视化编辑、COFECHA 验证与事件级交叉定年桌面工作站。",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
